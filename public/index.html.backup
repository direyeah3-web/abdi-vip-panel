<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=900, initial-scale=0.5, maximum-scale=3.0, user-scalable=yes">
<title>ABDI VIP PANEL</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
:root{--bg:#0a0a0f;--sidebar:#0d0d14;--card:#12121a;--card-hover:#1a1a24;--text:#fff;--muted:#6b6b7e;--primary:#00d4ff;--purple:#8b5cf6;--green:#10b981;--yellow:#f59e0b;--red:#ef4444;--border:#1e1e2a;}
[data-theme="light"]{
    --bg:#0d1b2a;
    --sidebar:#0f2236;
    --card:#142a42;
    --card-hover:#1a3554;
    --text:#e6f1ff;
    --muted:#7b98b8;
    --primary:#00d4ff;
    --purple:#8b5cf6;
    --green:#10b981;
    --yellow:#f59e0b;
    --red:#ef4444;
    --border:#1e3a5f;
}
[data-theme="light"] body{background:url('/bg-light.png') center/cover no-repeat fixed !important;}
[data-theme="light"] .sidebar{background:rgba(15,34,54,0.75) !important;border-right:1px solid #1e3a5f;backdrop-filter:blur(15px);}
[data-theme="light"] .card,[data-theme="light"] .stat-card,[data-theme="light"] .panel,[data-theme="light"] .hero{background:rgba(0,0,0,0.55) !important;border:1px solid rgba(255,255,255,0.15) !important;box-shadow:0 4px 20px rgba(0,0,0,0.3) !important;backdrop-filter:blur(12px);}
[data-theme="light"] input,[data-theme="light"] select{background:rgba(0,0,0,0.5) !important;border:1px solid rgba(255,255,255,0.15) !important;color:#fff !important;backdrop-filter:blur(8px);}
[data-theme="light"] .quick-action{background:#f1f5f9;}
[data-theme="light"] .quick-action:hover{background:#e2e8f0;}
[data-theme="light"] .tab{color:var(--muted);}
[data-theme="light"] .topnav{background:rgba(255,255,255,0.7) !important;border-bottom:1px solid var(--border);backdrop-filter:blur(15px);}
[data-theme="light"] .sidebar-logo,[data-theme="light"] .login-logo{background:linear-gradient(135deg,#0ea5e9,#7c3aed);}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',sans-serif;}
body{background:var(--bg);color:var(--text);overflow:hidden;}
#login{display:flex;justify-content:center;align-items:center;min-height:100vh;}
.login-card{background:var(--card);border:1px solid var(--border);border-radius:24px;padding:40px;width:90%;max-width:440px;box-shadow:0 20px 60px rgba(0,0,0,.5);}
.login-logo{width:64px;height:64px;background:linear-gradient(135deg,var(--primary),var(--purple));border-radius:18px;display:flex;justify-content:center;align-items:center;font-size:28px;margin-bottom:24px;box-shadow:0 8px 24px rgba(0,212,255,.3);}
.login-title{font-size:28px;font-weight:800;margin-bottom:8px;background:linear-gradient(135deg,#fff,#8b5cf6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.login-sub{color:var(--muted);font-size:14px;margin-bottom:32px;}
.tabs{display:flex;background:#0a0a0f;padding:5px;border-radius:12px;margin-bottom:24px;}
.tab{flex:1;padding:12px;text-align:center;cursor:pointer;border-radius:8px;font-weight:600;font-size:14px;color:var(--muted);transition:.2s;}
.tab.active{background:linear-gradient(135deg,var(--primary),var(--purple));color:#0a0a0f;}
.form-group{margin-bottom:18px;}
.form-group label{display:block;margin-bottom:8px;font-size:13px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;}
.input-wrapper{position:relative;display:flex;align-items:center;}
.input-wrapper i.prefix{position:absolute;left:16px;color:var(--muted);font-size:16px;}
.input-wrapper input{width:100%;padding:14px 16px 14px 48px;background:#0a0a0f;border:1px solid var(--border);border-radius:12px;color:var(--text);font-size:15px;outline:none;transition:.2s;}
.input-wrapper input:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(0,212,255,.1);}
.eye{position:absolute;right:16px;color:var(--muted);cursor:pointer;}
.submit-btn{width:100%;padding:15px;background:linear-gradient(135deg,var(--primary),var(--purple));color:#0a0a0f;border:none;border-radius:12px;font-size:15px;font-weight:700;cursor:pointer;display:flex;justify-content:center;align-items:center;gap:10px;transition:.3s;margin-top:10px;}
.submit-btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(0,212,255,.3);}
#dashboard{display:none;height:100vh;overflow:hidden;}
.sidebar{width:260px;background:var(--sidebar);border-right:1px solid var(--border);height:100vh;display:flex;flex-direction:column;position:fixed;left:0;top:0;z-index:100;}
.sidebar-header{padding:20px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--border);}
.sidebar-logo{width:36px;height:36px;background:linear-gradient(135deg,var(--primary),var(--purple));border-radius:10px;display:flex;justify-content:center;align-items:center;font-size:16px;color:#0a0a0f;font-weight:800;}
.sidebar-brand{font-size:16px;font-weight:700;}
.sidebar-brand small{display:block;font-size:11px;color:var(--muted);font-weight:400;}
.sidebar-nav{flex:1;padding:15px 10px;overflow-y:auto;}
.nav-section{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;padding:15px 12px 8px;font-weight:600;}
.nav-item{display:flex;align-items:center;gap:12px;padding:10px 14px;color:var(--muted);text-decoration:none;border-radius:10px;font-size:14px;font-weight:500;transition:.2s;margin-bottom:2px;cursor:pointer;}
.nav-item:hover{background:var(--card-hover);color:var(--text);}
.nav-item.active{background:linear-gradient(135deg,rgba(0,212,255,.15),rgba(139,92,246,.15));color:var(--primary);border-left:3px solid var(--primary);}
.nav-item i{width:18px;text-align:center;}
.sidebar-footer{padding:15px;border-top:1px solid var(--border);}
.user-card{display:flex;align-items:center;gap:10px;padding:10px;background:var(--card);border-radius:12px;}
.user-avatar{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--primary),var(--purple));display:flex;justify-content:center;align-items:center;font-weight:700;color:#0a0a0f;font-size:14px;}
.user-info div:first-child{font-size:13px;font-weight:600;}
.user-info div:last-child{font-size:11px;color:var(--muted);}
.main{margin-left:260px;height:100vh;overflow-y:auto;background:var(--bg);}
.topnav{padding:15px 30px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--border);background:var(--bg);position:sticky;top:0;z-index:50;}
.search-bar{display:flex;align-items:center;background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 15px;width:400px;max-width:100%;}
.search-bar i{color:var(--muted);margin-right:10px;}
.search-bar input{background:transparent;border:none;color:var(--text);outline:none;width:100%;font-size:14px;}
.status-badge{display:flex;align-items:center;gap:8px;padding:8px 14px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:20px;font-size:13px;color:var(--green);font-weight:600;}
.status-dot{width:8px;height:8px;background:var(--green);border-radius:50%;animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.page{padding:30px;}
.hero{background:linear-gradient(135deg,rgba(0,212,255,.1),rgba(139,92,246,.1));border:1px solid var(--border);border-radius:20px;padding:35px;margin-bottom:30px;}
.hero-badge{display:inline-block;padding:4px 12px;background:rgba(0,212,255,.15);color:var(--primary);border-radius:20px;font-size:12px;font-weight:600;margin-bottom:15px;}
.hero h1{font-size:32px;font-weight:800;margin-bottom:10px;}
.hero h1 span{background:linear-gradient(135deg,var(--primary),var(--purple));-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.hero p{color:var(--muted);font-size:15px;max-width:600px;margin-bottom:25px;}
.hero-buttons{display:flex;gap:12px;flex-wrap:wrap;}
.btn-primary{padding:12px 24px;background:linear-gradient(135deg,var(--primary),var(--purple));color:#0a0a0f;border:none;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:8px;transition:.2s;}
.btn-primary:hover{transform:translateY(-2px);}
.btn-secondary{padding:12px 24px;background:transparent;color:var(--text);border:1px solid var(--border);border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:8px;transition:.2s;}
.btn-secondary:hover{background:var(--card-hover);}
.stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-bottom:30px;}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:24px;transition:.2s;}
.stat-card:hover{border-color:var(--primary);transform:translateY(-3px);}
.stat-icon{width:44px;height:44px;border-radius:12px;display:flex;justify-content:center;align-items:center;font-size:18px;margin-bottom:16px;}
.stat-icon.blue{background:rgba(0,212,255,.15);color:var(--primary);}
.stat-icon.purple{background:rgba(139,92,246,.15);color:var(--purple);}
.stat-icon.green{background:rgba(16,185,129,.15);color:var(--green);}
.stat-icon.yellow{background:rgba(245,158,11,.15);color:var(--yellow);}
.stat-value{font-size:32px;font-weight:800;margin-bottom:4px;}
.stat-label{font-size:13px;color:var(--muted);font-weight:500;}
.content-grid{display:grid;grid-template-columns:2fr 1fr;gap:20px;}
.panel{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:24px;}
.panel-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;}
.panel-header h3{font-size:16px;font-weight:700;}
.quick-action{display:flex;align-items:center;gap:12px;padding:14px;border-radius:10px;background:#0a0a0f;margin-bottom:10px;cursor:pointer;transition:.2s;border:1px solid transparent;}
.quick-action:hover{border-color:var(--primary);background:var(--card-hover);}
.quick-action i{color:var(--primary);width:20px;}
.quick-action span{font-size:14px;font-weight:500;}
table{width:100%;border-collapse:collapse;}
th{text-align:left;padding:12px;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid var(--border);}
td{padding:14px 12px;font-size:14px;border-bottom:1px solid var(--border);}
tr:hover td{background:var(--card-hover);}
.modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.8);z-index:9999;justify-content:center;align-items:center;backdrop-filter:blur(5px);}
.modal-content{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:30px;width:90%;max-width:500px;animation:slideUp .3s ease;}
@keyframes slideUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px;}
.modal-header h2{font-size:20px;font-weight:700;}
.modal-close{background:transparent;border:none;color:var(--muted);font-size:22px;cursor:pointer;}
.duration-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:20px;}
.duration-btn{padding:12px;background:#0a0a0f;border:1px solid var(--border);border-radius:10px;color:var(--muted);cursor:pointer;font-size:13px;font-weight:600;transition:.2s;}
.duration-btn:hover{border-color:var(--primary);color:var(--primary);}
.duration-btn.active{background:linear-gradient(135deg,var(--primary),var(--purple));color:#0a0a0f;border-color:transparent;}
input,select{width:100%;padding:12px 14px;background:#0a0a0f;border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:14px;outline:none;margin-bottom:15px;}
input:focus,select:focus{border-color:var(--primary);}
label{display:block;margin-bottom:8px;font-size:13px;font-weight:600;color:var(--muted);}

.menu-toggle{display:none;background:var(--card);border:1px solid var(--border);color:var(--text);width:40px;height:40px;border-radius:10px;cursor:pointer;align-items:center;justify-content:center;font-size:16px;}

.activity-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    border-radius: 10px;
    transition: 0.2s;
    margin-bottom: 5px;
}
.activity-item:hover { background: var(--card-hover); }
.activity-info div:first-child { font-size: 14px; font-weight: 600; margin-bottom: 2px; }
.activity-badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
}
.panel-header a {
    color: var(--primary);
    font-size: 13px;
    text-decoration: none;
    font-weight: 600;
}

.icon-btn {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--card);
    border: 1px solid var(--border);
    color: var(--text);
    cursor: pointer;
    transition: 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
}
.icon-btn:hover { background: var(--card-hover); border-color: var(--primary); }

@keyframes pulse-glow { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.6;transform:scale(1.05)} }
@keyframes slide-up { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
@keyframes shimmer { 0%{background-position:-500px 0} 100%{background-position:500px 0} }
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }
.live-clock { display:flex; align-items:center; gap:10px; padding:8px 16px; background:var(--input-bg); border:1px solid var(--border); border-radius:12px; font-weight:600; font-size:14px; }
.live-clock i { color:var(--primary); animation:pulse-glow 2s infinite; }
.online-badge { display:flex; align-items:center; gap:6px; padding:6px 12px; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.3); border-radius:20px; font-size:12px; color:var(--green); font-weight:600; }
.online-dot { width:8px; height:8px; background:var(--green); border-radius:50%; animation:pulse-glow 1.5s infinite; }
.stat-card-animated { animation:slide-up 0.5s ease-out; }
.hero { position:relative; overflow:hidden; }
.hero::before { content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%; background:radial-gradient(circle,rgba(139,92,246,0.15) 0%,transparent 70%); animation:float 6s ease-in-out infinite; pointer-events:none; }
.icon-btn { position:relative; }
.icon-btn .badge { position:absolute; top:5px; right:5px; width:8px; height:8px; background:var(--red); border-radius:50%; animation:pulse-glow 1s infinite; }
.chart-box { position:relative; overflow:hidden; }
.chart-box::after { content:''; position:absolute; top:0; left:-500px; width:500px; height:100%; background:linear-gradient(90deg,transparent,rgba(139,92,246,0.1),transparent); animation:shimmer 3s infinite; }


/* ===== GOD MODE STYLES ===== */
@keyframes pulseGlow { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(1.1)} }
@keyframes slideUp { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:translateY(0)} }
@keyframes shimmer { 0%{background-position:-1000px 0} 100%{background-position:1000px 0} }
@keyframes floaty { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
@keyframes spin { from{transform:rotate(0)} to{transform:rotate(360deg)} }
@keyframes fadeIn { from{opacity:0} to{opacity:1} }

body { background: linear-gradient(135deg,#0a0a0f 0%,#12121a 50%,#0a0a0f 100%) !important; }

.live-clock { display:flex;align-items:center;gap:8px;padding:8px 14px;background:var(--input-bg);border:1px solid var(--border);border-radius:12px;font-weight:700;font-size:13px;color:var(--primary);font-family:monospace; }
.live-clock i { animation:pulseGlow 2s infinite; }
.online-badge { display:flex;align-items:center;gap:6px;padding:6px 12px;background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);border-radius:20px;font-size:12px;color:var(--green);font-weight:700; }
.online-dot { width:8px;height:8px;background:var(--green);border-radius:50%;animation:pulseGlow 1.5s infinite;box-shadow:0 0 10px var(--green); }
.stat-card { animation:slideUp 0.5s ease-out backwards; }
.stat-card:nth-child(1){animation-delay:0.1s} .stat-card:nth-child(2){animation-delay:0.2s}
.stat-card:nth-child(3){animation-delay:0.3s} .stat-card:nth-child(4){animation-delay:0.4s}
.stat-card:hover { transform:translateY(-5px) scale(1.02); box-shadow:0 15px 40px rgba(139,92,246,0.2); }
.stat-value { background:linear-gradient(135deg,#fff,#8b5cf6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text; }
.hero { position:relative;overflow:hidden;animation:fadeIn 0.8s ease-out; }
.hero::before { content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(139,92,246,0.2) 0%,transparent 60%);animation:floaty 8s ease-in-out infinite;pointer-events:none; }
.hero h1 { position:relative;z-index:1; }
.chart-box { position:relative;overflow:hidden;animation:slideUp 0.6s ease-out; }
.chart-box::before { content:'';position:absolute;top:0;left:-1000px;width:1000px;height:100%;background:linear-gradient(90deg,transparent,rgba(139,92,246,0.08),transparent);animation:shimmer 4s infinite;pointer-events:none; }
.btn-primary { position:relative;overflow:hidden;transition:all 0.3s; }
.btn-primary:hover { transform:translateY(-3px);box-shadow:0 15px 40px rgba(139,92,246,0.5); }
.panel { animation:slideUp 0.5s ease-out;transition:all 0.3s; }
.panel:hover { border-color:rgba(139,92,246,0.3); }
.quick-action { transition:all 0.3s; }
.quick-action:hover { transform:translateX(5px);background:rgba(139,92,246,0.15); }
.activity-item { animation:fadeIn 0.5s ease-out;transition:all 0.3s; }
.activity-item:hover { transform:translateX(5px);background:rgba(139,92,246,0.08); }
.sidebar-logo img { animation:floaty 3s ease-in-out infinite; }


/* ===== GOD MODE 2.0 STYLES ===== */
@keyframes pulseGlow { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.5;transform:scale(1.1)} }
@keyframes slideUp { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:translateY(0)} }
@keyframes fadeIn { from{opacity:0} to{opacity:1} }
@keyframes shimmer { 0%{background-position:-1000px 0} 100%{background-position:1000px 0} }
@keyframes floaty { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }

.live-clock { display:flex;align-items:center;gap:8px;padding:8px 14px;background:var(--input-bg);border:1px solid var(--border);border-radius:12px;font-weight:700;font-size:13px;color:var(--primary);font-family:monospace; }
.live-clock i { animation:pulseGlow 2s infinite; }
.online-badge { display:flex;align-items:center;gap:6px;padding:6px 12px;background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);border-radius:20px;font-size:12px;color:var(--green);font-weight:700; }
.online-dot { width:8px;height:8px;background:var(--green);border-radius:50%;animation:pulseGlow 1.5s infinite;box-shadow:0 0 10px var(--green); }
.stat-card { animation:slideUp 0.5s ease-out backwards; transition:all 0.3s; }
.stat-card:nth-child(1){animation-delay:0.1s} .stat-card:nth-child(2){animation-delay:0.2s}
.stat-card:nth-child(3){animation-delay:0.3s} .stat-card:nth-child(4){animation-delay:0.4s}
.stat-card:hover { transform:translateY(-5px) scale(1.02); box-shadow:0 15px 40px rgba(139,92,246,0.2); }
.stat-value { background:linear-gradient(135deg,#fff,#8b5cf6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text; }
.hero { position:relative;overflow:hidden;animation:fadeIn 0.8s ease-out; }
.hero::before { content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(139,92,246,0.2) 0%,transparent 60%);animation:floaty 8s ease-in-out infinite;pointer-events:none; }
.chart-box { position:relative;overflow:hidden;animation:slideUp 0.6s ease-out; }
.chart-box::before { content:'';position:absolute;top:0;left:-1000px;width:1000px;height:100%;background:linear-gradient(90deg,transparent,rgba(139,92,246,0.08),transparent);animation:shimmer 4s infinite;pointer-events:none; }
.btn-primary { transition:all 0.3s; }
.btn-primary:hover { transform:translateY(-3px);box-shadow:0 15px 40px rgba(139,92,246,0.5); }
.panel { animation:slideUp 0.5s ease-out;transition:all 0.3s; }
.panel:hover { border-color:rgba(139,92,246,0.3); }
.quick-action { transition:all 0.3s; }
.quick-action:hover { transform:translateX(5px);background:rgba(139,92,246,0.15); }
.activity-item { animation:fadeIn 0.5s ease-out;transition:all 0.3s; }
.activity-item:hover { transform:translateX(5px);background:rgba(139,92,246,0.08); }
.sidebar-logo img { animation:floaty 3s ease-in-out infinite; }
.export-btn { display:inline-flex;align-items:center;gap:8px;padding:10px 18px;background:linear-gradient(135deg,var(--green),#059669);color:white;border:none;border-radius:10px;font-weight:600;cursor:pointer;transition:all 0.3s; }
.export-btn:hover { transform:translateY(-3px);box-shadow:0 10px 30px rgba(16,185,129,0.4); }
.notification-badge { position:absolute;top:6px;right:6px;width:10px;height:10px;background:var(--red);border-radius:50%;animation:pulseGlow 1.5s infinite; }


/* ===== MODERN MODAL STYLES ===== */
@keyframes modalSlideUp { from{opacity:0;transform:translateY(50px) scale(0.95)} to{opacity:1;transform:translateY(0) scale(1)} }
@keyframes modalFadeIn { from{opacity:0} to{opacity:1} }
@keyframes gradientShift { 0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%} }

.modern-modal-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(10px);
    z-index: 9999;
    justify-content: center;
    align-items: center;
    animation: modalFadeIn 0.3s ease;
}
.modern-modal-overlay.active { display: flex; }

.modern-modal {
    background: linear-gradient(135deg, var(--card-bg) 0%, #1a1a2e 100%);
    border: 1px solid rgba(139,92,246,0.3);
    border-radius: 24px;
    padding: 35px;
    width: 90%;
    max-width: 480px;
    box-shadow: 0 30px 80px rgba(139,92,246,0.3), 0 0 0 1px rgba(139,92,246,0.1) inset;
    animation: modalSlideUp 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    overflow: hidden;
}
.modern-modal::before {
    content: '';
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: radial-gradient(circle, rgba(139,92,246,0.15) 0%, transparent 60%);
    animation: gradientShift 8s ease infinite;
    pointer-events: none;
}
.modern-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    position: relative;
    z-index: 1;
}
.modern-modal-title {
    font-size: 24px;
    font-weight: 800;
    background: linear-gradient(135deg, #fff, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: flex;
    align-items: center;
    gap: 12px;
}
.modern-modal-title i {
    -webkit-text-fill-color: #8b5cf6;
    font-size: 22px;
}
.modern-modal-close {
    background: rgba(239,68,68,0.1);
    border: 1px solid rgba(239,68,68,0.3);
    color: #ef4444;
    width: 36px; height: 36px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 16px;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
}
.modern-modal-close:hover {
    background: #ef4444;
    color: white;
    transform: rotate(90deg);
}
.modern-label {
    display: block;
    margin-bottom: 10px;
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    position: relative;
    z-index: 1;
}
.modern-duration-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 24px;
    position: relative;
    z-index: 1;
}
.modern-duration-btn {
    padding: 14px 8px;
    background: rgba(139,92,246,0.05);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--muted);
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.3s;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
}
.modern-duration-btn i { font-size: 16px; }
.modern-duration-btn:hover {
    background: rgba(139,92,246,0.15);
    border-color: rgba(139,92,246,0.5);
    color: var(--text);
    transform: translateY(-3px);
}
.modern-duration-btn.active {
    background: linear-gradient(135deg, #00d4ff, #8b5cf6);
    color: white;
    border-color: transparent;
    box-shadow: 0 10px 30px rgba(139,92,246,0.4);
}
.modern-quantity-input {
    width: 100%;
    padding: 16px 20px;
    background: rgba(0,0,0,0.3);
    border: 2px solid var(--border);
    border-radius: 14px;
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
    outline: none;
    margin-bottom: 24px;
    transition: all 0.3s;
    position: relative;
    z-index: 1;
    box-sizing: border-box;
}
.modern-quantity-input:focus {
    border-color: #8b5cf6;
    box-shadow: 0 0 0 4px rgba(139,92,246,0.15);
}
.modern-generate-btn {
    width: 100%;
    padding: 18px;
    background: linear-gradient(135deg, #00d4ff, #8b5cf6);
    border: none;
    border-radius: 14px;
    color: white;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: all 0.3s;
    position: relative;
    z-index: 1;
    text-transform: uppercase;
    letter-spacing: 1px;
}
.modern-generate-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 50px rgba(139,92,246,0.5);
}
.modern-generate-btn:active { transform: translateY(0); }


/* ===== TOAST STYLES ===== */
@keyframes toastSlideIn { from{opacity:0;transform:translateX(400px)} to{opacity:1;transform:translateX(0)} }
@keyframes toastSlideOut { from{opacity:1;transform:translateX(0)} to{opacity:0;transform:translateX(400px)} }
@keyframes toastProgress { from{width:100%} to{width:0%} }

.toast-container { position:fixed;top:20px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:10px; }
.toast { display:flex;align-items:center;gap:14px;padding:16px 20px;background:linear-gradient(135deg,#1a1a2e,#16213e);border:1px solid rgba(139,92,246,0.3);border-radius:14px;box-shadow:0 20px 50px rgba(0,0,0,0.5);min-width:300px;max-width:400px;animation:toastSlideIn 0.4s cubic-bezier(0.34,1.56,0.64,1);position:relative;overflow:hidden; }
.toast.removing { animation:toastSlideOut 0.3s ease-out forwards; }
.toast-icon { width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0; }
.toast-icon.success { background:rgba(16,185,129,0.2);color:#10b981; }
.toast-icon.error { background:rgba(239,68,68,0.2);color:#ef4444; }
.toast-icon.info { background:rgba(0,212,255,0.2);color:#00d4ff; }
.toast-content { flex:1; }
.toast-title { font-size:14px;font-weight:700;color:#fff;margin-bottom:2px; }
.toast-message { font-size:13px;color:#8b8b9e; }
.toast-close { background:transparent;border:none;color:#8b8b9e;font-size:16px;cursor:pointer;padding:5px;transition:all 0.2s; }
.toast-close:hover { color:#ef4444; }
.toast-progress { position:absolute;bottom:0;left:0;height:3px;background:linear-gradient(90deg,#00d4ff,#8b5cf6);animation:toastProgress 3s linear forwards; }


.profile-card-bg::before { content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(139,92,246,0.15) 0%,transparent 60%);animation:floaty 6s ease-in-out infinite;pointer-events:none; }


@keyframes themeTransition { from{opacity:0.5;transform:scale(0.98)} to{opacity:1;transform:scale(1)} }
[data-theme="light"] .main,
[data-theme="light"] .sidebar,
[data-theme="light"] .card,
[data-theme="light"] .panel {
    animation:themeTransition 0.4s ease-out;
}
.theme-btn { transition:all 0.3s cubic-bezier(0.34,1.56,0.64,1); }
.theme-btn:hover { transform:scale(1.15) rotate(15deg); }


[data-theme="light"] .quick-action{background:#0d1b2a !important;border:1px solid #1e3a5f;}
[data-theme="light"] .quick-action:hover{background:#1a3554 !important;border-color:#00d4ff !important;}
[data-theme="light"] .nav-item:hover,[data-theme="light"] .nav-item.active{background:linear-gradient(135deg,rgba(0,212,255,0.15),rgba(139,92,246,0.15)) !important;color:#00d4ff !important;}
[data-theme="light"] .topnav{background:rgba(15,34,54,0.9) !important;border-bottom:1px solid #1e3a5f !important;backdrop-filter:blur(20px);}
[data-theme="light"] .btn-primary{background:linear-gradient(135deg,#00d4ff,#8b5cf6) !important;color:white !important;}
[data-theme="light"] .submit-btn{background:linear-gradient(135deg,#00d4ff,#8b5cf6) !important;color:white !important;}
[data-theme="light"] .stat-value{background:linear-gradient(135deg,#00d4ff,#8b5cf6) !important;-webkit-background-clip:text !important;-webkit-text-fill-color:transparent !important;background-clip:text !important;}
[data-theme="light"] .live-clock{background:#0d1b2a !important;border:1px solid #1e3a5f !important;color:#00d4ff !important;}
[data-theme="light"] .online-badge{background:rgba(16,185,129,0.15) !important;border:1px solid rgba(16,185,129,0.3) !important;color:#10b981 !important;}
[data-theme="light"] .icon-btn{background:#142a42 !important;border:1px solid #1e3a5f !important;color:#e6f1ff !important;}
[data-theme="light"] .toast{background:rgba(0,0,0,0.75) !important;border:1px solid rgba(255,255,255,0.15) !important;backdrop-filter:blur(15px);}
[data-theme="light"] .toast-title{color:#e6f1ff !important;}
[data-theme="light"] .toast-message{color:#7b98b8 !important;}
[data-theme="light"] .theme-btn.active{background:#00d4ff !important;color:#0d1b2a !important;}
[data-theme="light"] .status-badge{background:rgba(16,185,129,0.15) !important;border:1px solid rgba(16,185,129,0.3) !important;color:#10b981 !important;}
[data-theme="light"] .chart-box{background:rgba(0,0,0,0.5) !important;backdrop-filter:blur(12px);}

</style>

<style>
/* ===== FORCE DESKTOP VIEW ===== */
html, body {
    min-width: 900px;
}
.sidebar {
    width: 260px !important;
}
.sidebar-brand, .nav-item span, .nav-section, .user-info {
    display: block !important;
}
.nav-item {
    justify-content: flex-start !important;
}
.main {
    margin-left: 260px !important;
}
.content-grid {
    grid-template-columns: 2fr 1fr !important;
}
.stats-grid {
    grid-template-columns: repeat(4, 1fr) !important;
}
.search-bar {
    width: 400px !important;
}
.topnav {
    padding: 15px 30px !important;
    flex-wrap: nowrap !important;
}
.hero {
    padding: 35px !important;
}
.hero h1 {
    font-size: 32px !important;
}
.page {
    padding: 30px !important;
}
.menu-toggle {
    display: none !important;
}
.mobile-overlay {
    display: none !important;
}

@keyframes pulse-glow { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:0.6;transform:scale(1.05)} }
@keyframes slide-up { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
@keyframes shimmer { 0%{background-position:-500px 0} 100%{background-position:500px 0} }
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }
.live-clock { display:flex; align-items:center; gap:10px; padding:8px 16px; background:var(--input-bg); border:1px solid var(--border); border-radius:12px; font-weight:600; font-size:14px; }
.live-clock i { color:var(--primary); animation:pulse-glow 2s infinite; }
.online-badge { display:flex; align-items:center; gap:6px; padding:6px 12px; background:rgba(16,185,129,0.15); border:1px solid rgba(16,185,129,0.3); border-radius:20px; font-size:12px; color:var(--green); font-weight:600; }
.online-dot { width:8px; height:8px; background:var(--green); border-radius:50%; animation:pulse-glow 1.5s infinite; }
.stat-card-animated { animation:slide-up 0.5s ease-out; }
.hero { position:relative; overflow:hidden; }
.hero::before { content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%; background:radial-gradient(circle,rgba(139,92,246,0.15) 0%,transparent 70%); animation:float 6s ease-in-out infinite; pointer-events:none; }
.icon-btn { position:relative; }
.icon-btn .badge { position:absolute; top:5px; right:5px; width:8px; height:8px; background:var(--red); border-radius:50%; animation:pulse-glow 1s infinite; }
.chart-box { position:relative; overflow:hidden; }
.chart-box::after { content:''; position:absolute; top:0; left:-500px; width:500px; height:100%; background:linear-gradient(90deg,transparent,rgba(139,92,246,0.1),transparent); animation:shimmer 3s infinite; }

</style>
</head>
<body>

<div id="login">
<div class="login-card">
<div class="login-logo"><img src="/logo.png" alt="Logo" style="width:100%;height:100%;object-fit:cover;border-radius:18px;"></div>
<h1 class="login-title">ABDI VIP PANEL</h1>
<p class="login-sub">Sign in to access your autonomous dashboard</p>
<div class="tabs">
<div class="tab active" id="tab-login" onclick="switchTab('login')">Login</div>
<div class="tab" id="tab-register" onclick="switchTab('register')">Register</div>
</div>
<form id="login-form" onsubmit="handleLogin(event)">
<div class="form-group"><label>Username</label><div class="input-wrapper"><i class="fa-regular fa-user prefix"></i><input type="text" id="login-username" placeholder="Enter username" required></div></div>
<div class="form-group"><label>Password</label><div class="input-wrapper"><i class="fa-solid fa-lock prefix"></i><input type="password" id="login-password" placeholder="Enter password" required><i class="fa-regular fa-eye eye" onclick="togglePassword('login-password',this)"></i></div></div>
<button type="submit" class="submit-btn"><i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In</button>
</form>
<form id="register-form" style="display:none;" onsubmit="handleRegister(event)">
<div class="form-group"><label>Username</label><div class="input-wrapper"><i class="fa-regular fa-user prefix"></i><input type="text" id="reg-username" placeholder="Choose username" required></div></div>
<div class="form-group"><label>Password</label><div class="input-wrapper"><i class="fa-solid fa-lock prefix"></i><input type="password" id="reg-password" placeholder="Create password" required></div></div>

            <div class="form-group"><label>Referral Code <span style="color:var(--red);">*</span></label><div class="input-wrapper"><i class="fa-solid fa-key prefix"></i><input type="text" id="reg-referral" placeholder="Enter referral code" required></div></div>
<button type="submit" class="submit-btn"><i class="fa-solid fa-user-plus"></i> Create Account</button>
</form>
</div>
</div>

<div id="dashboard">
<div class="mobile-overlay" id="mobile-overlay" onclick="toggleSidebar()"></div>
<aside class="sidebar" id="sidebar">
<div class="sidebar-header"><div class="sidebar-logo"><img src="/logo.png" alt="Logo" style="width:100%;height:100%;object-fit:cover;border-radius:10px;"></div><div class="sidebar-brand">ABDI VIP<small>Autonomous Panel</small></div></div>
<nav class="sidebar-nav">
<div class="nav-section">Main</div>
<a class="nav-item active" onclick="loadPage('dashboard',this)"><i class="fa-solid fa-chart-pie"></i> <span>Dashboard</span></a>
<a class="nav-item" onclick="loadPage('users',this)"><i class="fa-solid fa-users"></i> <span>Users</span></a>
<a class="nav-item" onclick="loadPage('licenses',this)"><i class="fa-solid fa-key"></i> <span>Licenses</span></a>
<a class="nav-item" onclick="loadPage('referrals',this)"><i class="fa-solid fa-share-nodes"></i> <span>Referrals</span></a>
<div class="nav-section">System</div>
<a class="nav-item" onclick="loadPage('status',this)"><i class="fa-solid fa-signal"></i> <span>System Status</span></a>
<a class="nav-item" onclick="loadPage('settings',this)"><i class="fa-solid fa-gear"></i> <span>Settings</span></a>
<a class="nav-item" onclick="handleLogout()"><i class="fa-solid fa-right-from-bracket"></i> <span>Logout</span></a>
</nav>
<div class="sidebar-footer"><div class="user-card"><div class="user-avatar" id="user-avatar">A</div><div class="user-info"><div id="user-name">Abdi</div><div id="user-role">Admin</div></div></div></div>
</aside>
<main class="main">
<header class="topnav">
<button class="menu-toggle" onclick="toggleSidebar()"><i class="fa-solid fa-bars"></i></button>
<div class="search-bar"><i class="fa-solid fa-search"></i><input type="text" placeholder="Search..."></div>
<div style="display:flex;align-items:center;gap:8px;">
<div class="live-clock"><i class="fa-solid fa-clock"></i><span id="live-clock-text">--:--:--</span></div>
                <div class="online-badge"><div class="online-dot"></div><span id="online-count">0 Online</span></div>
                <div class="live-clock"><i class="fa-solid fa-clock"></i><span id="live-clock">--:--:--</span></div>
                <div class="online-badge"><div class="online-dot"></div><span id="online-count">Loading</span></div>
                <div class="status-badge"><div class="status-dot"></div><span class="status-text">Active</span></div>
<button class="icon-btn" onclick="toggleTheme()" title="Toggle Theme"><i class="fa-solid fa-sun" id="theme-icon"></i></button>
<button class="icon-btn" onclick="showNotifications()" title="Notifications" style="position:relative;"><i class="fa-regular fa-bell"></i><span style="position:absolute;top:6px;right:6px;width:8px;height:8px;background:var(--red);border-radius:50%;"></span></button>
<button class="submit-btn" style="width:auto;padding:10px 14px;margin:0;" onclick="handleLogout()"><i class="fa-solid fa-right-from-bracket"></i></button>
</div>
</header>
<div id="page-content" class="page"></div>
</main>
</div>

<div id="license-modal" class="modal">
<div class="modal-content">
<div class="modal-header"><h2>Generate License</h2><button class="modal-close" onclick="closeLicenseModal()"><i class="fa-solid fa-xmark"></i></button></div>
<label>Duration</label>
<div class="duration-grid">
<button type="button" class="duration-btn active" data-days="1" onclick="selectDuration(this,1)">1 Day</button>
<button type="button" class="duration-btn" data-days="7" onclick="selectDuration(this,7)">7 Days</button>
<button type="button" class="duration-btn" data-days="30" onclick="selectDuration(this,30)">30 Days</button>
<button type="button" class="duration-btn" data-days="90" onclick="selectDuration(this,90)">90 Days</button>
<button type="button" class="duration-btn" data-days="365" onclick="selectDuration(this,365)">1 Year</button>
<button type="button" class="duration-btn" data-days="custom" onclick="selectDuration(this,'custom')">Custom</button>
</div>
<input type="number" id="custom-days" placeholder="Enter number of days" style="display:none;">
<label>Quantity</label>
<input type="number" id="license-quantity" value="1" min="1" max="100">
<button class="submit-btn" onclick="generateLicenses()"><i class="fa-solid fa-plus"></i> Generate</button>
</div>
</div>

<div id="add-user-modal" class="modal">
<div class="modal-content">
<div class="modal-header"><h2>Add User</h2><button class="modal-close" onclick="closeAddUserModal()"><i class="fa-solid fa-xmark"></i></button></div>
<label>Username</label><input type="text" id="new-username" placeholder="Enter username">
<label>Password</label><input type="password" id="new-password" placeholder="Enter password">
<label>Full Name</label><input type="text" id="new-fullname" placeholder="Enter full name">
<button class="submit-btn" onclick="addUser()"><i class="fa-solid fa-plus"></i> Add User</button>
</div>
</div>

<script>
function switchTab(t){document.getElementById('tab-login').classList.toggle('active',t==='login');document.getElementById('tab-register').classList.toggle('active',t==='register');document.getElementById('login-form').style.display=t==='login'?'block':'none';document.getElementById('register-form').style.display=t==='register'?'block':'none';}
function togglePassword(id,icon){var i=document.getElementById(id);if(i.type==='password'){i.type='text';icon.classList.remove('fa-eye');icon.classList.add('fa-eye-slash');}else{i.type='password';icon.classList.remove('fa-eye-slash');icon.classList.add('fa-eye');}}
async function handleLogin(e){e.preventDefault();var u=document.getElementById('login-username').value;var p=document.getElementById('login-password').value;var b=e.target.querySelector('button');b.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Signing in...';b.disabled=true;try{var r=await fetch('/api/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})});var d=await r.json();if(d.success||d.token){localStorage.setItem('token',d.token);localStorage.setItem('user',JSON.stringify(d.user||{}));showDashboard();}else{showToast('Login Failed', d.message||d.error||'Invalid credentials', 'error');b.innerHTML='<i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In';b.disabled=false;}}catch(x){showToast('Error', x.message, 'error');b.innerHTML='<i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In';b.disabled=false;}}
async function handleRegister(e){e.preventDefault();var u=document.getElementById('reg-username').value;var p=document.getElementById('reg-password').value;var ref=document.getElementById('reg-referral').value.trim().toUpperCase();if(!ref){showToast('Warning','Referral code waa loo baahan yahay!','info');return;}try{var r=await fetch('/api/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p,referral_code:ref})});var d=await r.json();if(d.success||d.token){showToast('Success!', 'Account created! Please login.', 'success');switchTab('login');}else{showToast('Error', d.error||'Registration failed', 'error');}}catch(x){showToast('Error', x.message, 'error');}}
function showDashboard(){document.getElementById('login').style.display='none';document.getElementById('dashboard').style.display='block';var u=JSON.parse(localStorage.getItem('user')||'{}');if(u.username){document.getElementById('user-name').textContent=u.username;document.getElementById('user-avatar').textContent=u.username.charAt(0).toUpperCase();document.getElementById('user-role').textContent=u.role||'User';}loadPage('dashboard');}
async function loadPage(p,el){if(el){document.querySelectorAll('.nav-item').forEach(function(x){x.classList.remove('active');});el.classList.add('active');}var c=document.getElementById('page-content');var u=JSON.parse(localStorage.getItem('user')||'{}');
if(p==='dashboard'){
        c.innerHTML='<div class="hero"><div class="hero-badge">Welcome Back</div><h1>Hello, <span>'+(u.username||'User')+'</span></h1><p>You are in control. Here is what is happening with your panel today.</p><div class="hero-buttons"><button class="btn-primary" onclick="loadPage(\'licenses\')"><i class="fa-solid fa-plus"></i> Generate License</button><button class="btn-secondary" onclick="loadPage(\'users\')"><i class="fa-solid fa-users"></i> Manage Users</button></div></div>'+
        '<div class="stats-grid" id="stats-grid"><div class="stat-card">Loading...</div></div>'+
        '<div class="content-grid">'+
            '<div class="panel"><div class="panel-header"><h3>Analytics Overview</h3></div><canvas id="analyticsChart" height="220"></canvas></div>'+
            '<div class="panel"><div class="panel-header"><h3>License Status</h3></div><canvas id="licenseChart" height="220"></canvas></div>'+
        '</div>'+
        '<div class="content-grid" style="margin-top:20px;">'+
            '<div class="panel"><div class="panel-header"><h3>Profile</h3></div>'+
                '<div style="display:flex;align-items:center;gap:20px;padding:10px 0;">'+
                    '<div style="width:60px;height:60px;background:linear-gradient(135deg,var(--primary),var(--purple));border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:24px;color:#fff;"><i class="fa-solid fa-dollar-sign"></i></div>'+
                    '<div><div style="display:flex;align-items:center;gap:15px;"><div style="width:70px;height:70px;border-radius:50%;overflow:hidden;border:3px solid var(--primary);box-shadow:0 0 25px rgba(139,92,246,0.4);"><img src="/logo.png" alt="ABDI VIP" style="width:100%;height:100%;object-fit:cover;"></div><div><div style="font-size:22px;font-weight:800;background:linear-gradient(135deg,#fff,#8b5cf6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">ABDI VIP</div><div style="color:var(--muted);font-size:13px;">Autonomous Panel Owner</div></div></div></div>'+
                '</div>'+
            '</div>'+
            '<div class="panel"><div class="panel-header"><h3>Top Users</h3><a href="#">View All</a></div><div id="top-users"><p style="color:var(--muted);text-align:center;padding:20px;">Loading...</p></div></div>'+
        '</div>'+
        '<div class="content-grid" style="margin-top:20px;">'+
            '<div class="panel"><div class="panel-header"><h3>Recent Activity</h3><a href="#">View All</a></div><div id="activity-list"><p style="color:var(--muted);text-align:center;padding:20px;">Loading...</p></div></div>'+
            '<div class="panel"><div class="panel-header"><h3>Quick Actions</h3></div>'+
                '<div class="quick-action" onclick="loadPage(\'licenses\')"><i class="fa-solid fa-key"></i><span>Generate License</span></div>'+
                '<div class="quick-action" onclick="loadPage(\'users\')"><i class="fa-solid fa-user-plus"></i><span>Add User</span></div>'+
                '<div class="quick-action" onclick="loadPage(\'referrals\')"><i class="fa-solid fa-share-nodes"></i><span>View Referrals</span></div>'+
                '<div class="quick-action" onclick="loadPage(\'settings\')"><i class="fa-solid fa-gear"></i><span>System Settings</span></div>'+
            '</div>'+
        '</div>';
        await fetchStats();
        loadActivity();
        loadTopUsers();
    }
    else if(p==='users'){c.innerHTML='<div class="panel-header" style="margin-bottom:20px;"><h1 style="font-size:24px;font-weight:800;">Users Management</h1><button class="btn-primary" onclick="showAddUserModal()"><i class="fa-solid fa-plus"></i> Add User</button></div><div class="panel"><div style="overflow-x:auto;"><table><thead><tr><th>ID</th><th>Username</th><th>Full Name</th><th>Role</th><th>Actions</th></tr></thead><tbody id="users-tbody"><tr><td colspan="5" style="text-align:center;padding:20px;">Loading...</td></tr></tbody></table></div></div>';await loadUsers();}
else if(p==='licenses'){c.innerHTML='<div class="panel-header" style="margin-bottom:20px;"><h1 style="font-size:24px;font-weight:800;">Licenses Management</h1><button class="btn-primary" onclick="showModernLicenseModal()"><i class="fa-solid fa-plus"></i> Generate License</button></div><div class="panel"><div style="overflow-x:auto;"><table><thead><tr><th>License Key</th><th>Duration</th><th>Status</th><th>Actions</th></tr></thead><tbody id="licenses-tbody"><tr><td colspan="4" style="text-align:center;padding:20px;">Loading...</td></tr></tbody></table></div></div>';await loadLicenses();}
else if(p==='referrals'){c.innerHTML='<div class="panel-header" style="margin-bottom:20px;"><h1 style="font-size:24px;font-weight:800;">Referrals</h1></div><div class="panel"><div style="overflow-x:auto;"><table><thead><tr><th>ID</th><th>Referrer</th><th>Referred User</th></tr></thead><tbody id="referrals-tbody"><tr><td colspan="3" style="text-align:center;padding:20px;">Loading...</td></tr></tbody></table></div></div>';await loadReferrals();}
else if(p==='status'){
        c.innerHTML='<div class="panel-header" style="margin-bottom:20px;"><h1 style="font-size:24px;font-weight:800;">System Status</h1><button class="btn-secondary" onclick="loadPage(\'status\')"><i class="fa-solid fa-refresh"></i> Refresh</button></div>'+
        '<div class="stats-grid" id="status-grid">'+
            '<div class="stat-card"><div class="stat-icon blue"><i class="fa-solid fa-server"></i></div><div class="stat-value" id="server-status">...</div><div class="stat-label">Railway Server</div></div>'+
            '<div class="stat-card"><div class="stat-icon purple"><i class="fa-solid fa-cloud"></i></div><div class="stat-value" id="worker-status">...</div><div class="stat-label">Cloudflare Worker</div></div>'+
            '<div class="stat-card"><div class="stat-icon green"><i class="fa-solid fa-link"></i></div><div class="stat-value" id="connection-status">...</div><div class="stat-label">Connection</div></div>'+
            '<div class="stat-card"><div class="stat-icon yellow"><i class="fa-solid fa-clock"></i></div><div class="stat-value" id="response-time">...</div><div class="stat-label">Response Time</div></div>'+
        '</div>'+
        '<div class="content-grid" style="margin-top:20px;">'+
            '<div class="panel"><div class="panel-header"><h3>Server Details</h3></div><div id="server-details"><p style="color:var(--muted);text-align:center;padding:20px;">Loading...</p></div></div>'+
            '<div class="panel"><div class="panel-header"><h3>Worker Details</h3></div><div id="worker-details"><p style="color:var(--muted);text-align:center;padding:20px;">Loading...</p></div></div>'+
        '</div>'+
        '<div class="panel" style="margin-top:20px;"><div class="panel-header"><h3>Connection Test</h3></div>'+
            '<p style="color:var(--muted);margin-bottom:15px;">Test the connection between Cloudflare Worker and Railway Server.</p>'+
            '<input type="text" id="worker-url-input" value="https://a.dirxx.workers.dev" placeholder="Enter Worker URL" style="margin-bottom:15px;">'+
            '<button class="btn-primary" onclick="testWorkerConnection()"><i class="fa-solid fa-play"></i> Test Connection</button>'+
            '<div id="test-result" style="margin-top:20px;"></div>'+
        '</div>';
        await loadSystemStatus();
    }
    else if(p==='settings'){
        var user = JSON.parse(localStorage.getItem('user') || '{}');
        c.innerHTML='<div class="panel-header" style="margin-bottom:20px;"><h1 style="font-size:24px;font-weight:800;">Settings</h1></div>'+
        '<div style="display:grid;grid-template-columns:1fr;gap:20px;max-width:700px;">'+
            '<div class="panel"><h3 style="margin-bottom:15px;font-size:16px;"><i class="fa-solid fa-user" style="color:var(--primary);margin-right:8px;"></i> Profile Settings</h3>'+
                '<label style="display:block;font-size:13px;color:var(--muted);margin-bottom:6px;">Username</label>'+
                '<input type="text" id="settings-username" value="'+(user.username||'')+'" style="width:100%;padding:12px;background:var(--input-bg);border:1px solid var(--border);border-radius:10px;color:var(--text);outline:none;margin-bottom:15px;box-sizing:border-box;">'+
                '<label style="display:block;font-size:13px;color:var(--muted);margin-bottom:6px;">Full Name</label>'+
                '<input type="text" id="settings-fullname" value="'+(user.fullname||'')+'" style="width:100%;padding:12px;background:var(--input-bg);border:1px solid var(--border);border-radius:10px;color:var(--text);outline:none;margin-bottom:15px;box-sizing:border-box;">'+
                '<button class="btn-primary" onclick="saveProfile()" style="width:100%;"><i class="fa-solid fa-save"></i> Save Profile</button>'+
            '</div>'+
            '<div class="panel"><h3 style="margin-bottom:15px;font-size:16px;"><i class="fa-solid fa-lock" style="color:var(--primary);margin-right:8px;"></i> Change Password</h3>'+
                '<input type="password" id="settings-old-pass" placeholder="Password-ka hore" style="width:100%;padding:12px;background:var(--input-bg);border:1px solid var(--border);border-radius:10px;color:var(--text);outline:none;margin-bottom:15px;box-sizing:border-box;">'+
                '<input type="password" id="settings-new-pass" placeholder="Password-ka cusub" style="width:100%;padding:12px;background:var(--input-bg);border:1px solid var(--border);border-radius:10px;color:var(--text);outline:none;margin-bottom:15px;box-sizing:border-box;">'+
                '<button class="btn-primary" onclick="changePassword()" style="width:100%;"><i class="fa-solid fa-key"></i> Change Password</button>'+
            '</div>'+
            '<div class="panel"><h3 style="margin-bottom:15px;font-size:16px;"><i class="fa-solid fa-palette" style="color:var(--primary);margin-right:8px;"></i> Theme</h3>'+
                '<div style="display:flex;gap:10px;">'+
                    '<button class="btn-secondary" onclick="setTheme(&#39;dark&#39;)" style="flex:1;"><i class="fa-solid fa-moon"></i> Dark</button>'+
                    '<button class="btn-secondary" onclick="setTheme(&#39;light&#39;)" style="flex:1;"><i class="fa-solid fa-sun"></i> Light</button>'+
                '</div>'+
            '</div>'+
            '<div class="panel"><h3 style="margin-bottom:15px;font-size:16px;"><i class="fa-solid fa-download" style="color:var(--primary);margin-right:8px;"></i> Export Data</h3>'+
                '<p style="color:var(--muted);font-size:13px;margin-bottom:15px;">Soo dejiso xogta users-ka qaab CSV ah.</p>'+
                '<button class="export-btn" onclick="exportData()" style="width:100%;justify-content:center;"><i class="fa-solid fa-file-csv"></i> Export Users (CSV)</button>'+
            '</div>'+
        '</div>';
    }
    
    function saveProfile() {
        var newUsername = document.getElementById('settings-username').value.trim();
        var newFullname = document.getElementById('settings-fullname').value.trim();
        if (!newUsername) { showToast('Warning', 'Username waa loo baahan yahay', 'info'); return; }
        var user = JSON.parse(localStorage.getItem('user') || '{}');
        user.username = newUsername;
        user.fullname = newFullname;
        localStorage.setItem('user', JSON.stringify(user));
        document.getElementById('user-name').textContent = newUsername;
        showToast('Success!', 'Profile waa la keydiyay!', 'success');
    }
    
    function changePassword() {
        var oldPass = document.getElementById('settings-old-pass').value;
        var newPass = document.getElementById('settings-new-pass').value;
        if (!oldPass || !newPass) { showToast('Warning', 'Fadlan geli labada password', 'info'); return; }
        if (newPass.length < 6) { showToast('Warning', 'Password-ku waa inuu ka badan yahay 6 xaraf', 'info'); return; }
        document.getElementById('settings-old-pass').value = '';
        document.getElementById('settings-new-pass').value = '';
        showToast('Success!', 'Password-ka waa la beddelay!', 'success');
    }}
async function fetchStats(){try{var t=localStorage.getItem('token');var r=await fetch('/api/stats',{headers:{'Authorization':'Bearer '+t}});var d=await r.json();var g=document.getElementById('stats-grid');if(!g)return;g.innerHTML='<div class="stat-card"><div class="stat-icon blue"><i class="fa-solid fa-users"></i></div><div class="stat-value">'+(d.totalUsers||0)+'</div><div class="stat-label">Total Users</div></div><div class="stat-card"><div class="stat-icon purple"><i class="fa-solid fa-key"></i></div><div class="stat-value">'+(d.totalLicenses||0)+'</div><div class="stat-label">Total Licenses</div></div><div class="stat-card"><div class="stat-icon green"><i class="fa-solid fa-check-circle"></i></div><div class="stat-value">'+(d.unusedLicenses||0)+'</div><div class="stat-label">Available</div></div><div class="stat-card"><div class="stat-icon yellow"><i class="fa-solid fa-share-nodes"></i></div><div class="stat-value">'+(d.totalReferrals||0)+'</div><div class="stat-label">Referrals</div></div>';renderChart(d);}catch(e){console.error(e);}}
function renderChart(d){
    var c=document.getElementById('analyticsChart');
    if(c){
        if(window.myChart)window.myChart.destroy();
        window.myChart=new Chart(c.getContext('2d'),{
            type:'line',
            data:{labels:['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],datasets:[{label:'Activity',data:[2,4,3,6,5,8,d.totalUsers||1],borderColor:'#00d4ff',backgroundColor:'rgba(0,212,255,.1)',tension:.4,fill:true,borderWidth:2}]},
            options:{responsive:true,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true,grid:{color:'#1e1e2a'},ticks:{color:'#6b6b7e'}},x:{grid:{display:false},ticks:{color:'#6b6b7e'}}}}
        });
    }
    var c2=document.getElementById('licenseChart');
    if(c2){
        if(window.licenseChart)window.licenseChart.destroy();
        var unused = d.unusedLicenses || 0;
        var used = d.usedLicenses || 0;
        if (unused === 0 && used === 0) {
            c2.parentElement.innerHTML = '<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:200px;color:var(--muted);"><i class="fa-solid fa-chart-pie" style="font-size:40px;margin-bottom:15px;opacity:0.3;"></i><p>No license data yet</p><p style="font-size:12px;margin-top:5px;">Generate licenses to see the chart</p></div>';
        } else {
            window.licenseChart=new Chart(c2.getContext('2d'),{
                type:'doughnut',
                data:{labels:['Available','Used'],datasets:[{data:[unused,used],backgroundColor:['#10b981','#f59e0b'],borderWidth:0}]},
                options:{responsive:true,plugins:{legend:{position:'bottom',labels:{color:'#6b6b7e',padding:15}}},cutout:'70%'}
            });
        }
    }
}
async function loadUsers(){try{var t=localStorage.getItem('token');var r=await fetch('/api/admin/users',{headers:{'Authorization':'Bearer '+t}});var u=await r.json();var tb=document.getElementById('users-tbody');if(!tb)return;if(!Array.isArray(u)||u.length===0){tb.innerHTML='<tr><td colspan="5" style="text-align:center;padding:20px;">No users</td></tr>';return;}tb.innerHTML=u.map(function(x){return '<tr><td>#'+x.id+'</td><td><strong>'+x.username+'</strong></td><td>'+(x.fullname||'-')+'</td><td><span style="padding:4px 10px;border-radius:20px;background:'+(x.role==='admin'?'rgba(139,92,246,.2);color:#8b5cf6':'rgba(107,107,126,.2);color:#6b6b7e')+';font-size:12px;font-weight:600;">'+x.role+'</span></td><td><button onclick="deleteUser('+x.id+')" style="background:var(--red);border:none;color:white;padding:6px 12px;border-radius:8px;cursor:pointer;"><i class="fa-solid fa-trash"></i></button></td></tr>';}).join('');}catch(e){console.error(e);}}
async function deleteUser(id){if(!confirm('Delete this user?'))return;var t=localStorage.getItem('token');await fetch('/api/admin/users/'+id,{method:'DELETE',headers:{'Authorization':'Bearer '+t}});loadUsers();}
function showAddUserModal(){document.getElementById('add-user-modal').style.display='flex';}
function closeAddUserModal(){document.getElementById('add-user-modal').style.display='none';}
async function addUser(){var u=document.getElementById('new-username').value.trim();var p=document.getElementById('new-password').value.trim();var f=document.getElementById('new-fullname').value.trim();if(!u||!p){showToast('Warning', 'Username and password required', 'info');return;}try{var r=await fetch('/api/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p,referral_code:ref})});var d=await r.json();if(d.success||d.token){closeAddUserModal();showToast('Success!', 'User cusub waa la abuuray!', 'success');loadUsers();}else{showToast('Error', d.error||'Unknown error', 'error');}}catch(e){showToast('Error', e.message, 'error');}}
async function loadLicenses(){try{var t=localStorage.getItem('token');var r=await fetch('/api/licenses',{headers:{'Authorization':'Bearer '+t}});var l=await r.json();var tb=document.getElementById('licenses-tbody');if(!tb)return;if(!Array.isArray(l)||l.length===0){tb.innerHTML='<tr><td colspan="4" style="text-align:center;padding:20px;">No licenses</td></tr>';return;}tb.innerHTML=l.map(function(x){var col=x.status==='unused'?'#10b981':'#f59e0b';return '<tr><td><code style="background:#0a0a0f;padding:4px 8px;border-radius:6px;font-size:12px;">'+x.license_key+'</code></td><td>'+(x.duration||'-')+'</td><td><span style="padding:4px 10px;border-radius:20px;background:'+col+'20;color:'+col+';font-size:12px;font-weight:600;">'+x.status+'</span></td><td><button onclick="copyLicense(\''+x.license_key+'\')" style="background:var(--purple);border:none;color:white;padding:6px 10px;border-radius:8px;cursor:pointer;margin-right:5px;"><i class="fa-solid fa-copy"></i></button><button onclick="deleteLicense('+x.id+')" style="background:var(--red);border:none;color:white;padding:6px 10px;border-radius:8px;cursor:pointer;"><i class="fa-solid fa-trash"></i></button></td></tr>';}).join('');}catch(e){console.error(e);}}
async function deleteLicense(id){if(!confirm('Delete this license?'))return;var t=localStorage.getItem('token');await fetch('/api/admin/licenses/'+id,{method:'DELETE',headers:{'Authorization':'Bearer '+t}});loadLicenses();}
function copyLicense(k){navigator.clipboard.writeText(k).then(function(){showToast('Copied!', 'License key: '+k, 'success');});}
function showLicenseModal(){document.getElementById('license-modal').style.display='flex';}
function closeLicenseModal(){document.getElementById('license-modal').style.display='none';}
var selectedDays=1;
function selectDuration(b,d){document.querySelectorAll('.duration-btn').forEach(function(x){x.classList.remove('active');});b.classList.add('active');selectedDays=d;document.getElementById('custom-days').style.display=d==='custom'?'block':'none';}
async function generateLicenses(){var d=selectedDays;if(d==='custom'){d=parseInt(document.getElementById('custom-days').value);if(!d){showToast('Warning', 'Fadlan geli tirada maalmood ee saxda ah', 'info');return;}}var q=parseInt(document.getElementById('license-quantity').value)||1;try{var t=localStorage.getItem('token');var r=await fetch('/api/admin/licenses/bulk',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+t},body:JSON.stringify({days:d,quantity:q})});var data=await r.json();if(data.ok || data.success){closeLicenseModal();showToast('Success!', q+' license(s) waa la abuuray!', 'success');loadLicenses();}else{showToast('Error', data.error||'Unknown error', 'error');}}catch(e){showToast('Error', e.message, 'error');}}
async function loadReferrals(){try{var t=localStorage.getItem('token');var r=await fetch('/api/admin/referrals',{headers:{'Authorization':'Bearer '+t}});var d=await r.json();var tb=document.getElementById('referrals-tbody');if(!tb)return;if(!Array.isArray(d)||d.length===0){tb.innerHTML='<tr><td colspan="3" style="text-align:center;padding:20px;">No referrals</td></tr>';return;}tb.innerHTML=d.map(function(x){return '<tr><td>#'+x.id+'</td><td>'+x.referrer_code+'</td><td>'+x.referred_user+'</td></tr>';}).join('');}catch(e){console.error(e);}}

function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('mobile-overlay').classList.toggle('show');
}


async function loadActivity() {
    var list = document.getElementById('activity-list');
    if (!list) return;
    try {
        var token = localStorage.getItem('token');
        var res = await fetch('/api/stats', { headers: { 'Authorization': 'Bearer ' + token } });
        var data = await res.json();
        
        var activities = [
            { icon: 'fa-user-plus', color: 'blue', text: 'New user registered', time: '2 minutes ago', badge: 'Success' },
            { icon: 'fa-key', color: 'purple', text: 'License generated', time: '15 minutes ago', badge: 'Success' },
            { icon: 'fa-share-nodes', color: 'green', text: 'New referral', time: '1 hour ago', badge: 'New' },
            { icon: 'fa-gear', color: 'yellow', text: 'System updated', time: '3 hours ago', badge: 'Info' }
        ];
        
        list.innerHTML = activities.map(function(a) {
            return '<div class="activity-item">' +
                '<div class="activity-icon stat-icon ' + a.color + '" style="margin-bottom:0;width:36px;height:36px;font-size:14px;"><i class="fa-solid ' + a.icon + '"></i></div>' +
                '<div class="activity-info" style="flex:1;"><div>' + a.text + '</div><div style="font-size:12px;color:var(--muted);">' + a.time + '</div></div>' +
                '<span class="activity-badge" style="background:rgba(16,185,129,.2);color:#10b981;">' + a.badge + '</span>' +
            '</div>';
        }).join('');
    } catch(e) {
        list.innerHTML = '<p style="color:var(--muted);text-align:center;padding:20px;">No activity</p>';
    }
}


function toggleTheme() {
    var root = document.documentElement;
    var icon = document.getElementById('theme-icon');
    if (root.getAttribute('data-theme') === 'light') {
        root.removeAttribute('data-theme');
        icon.classList.remove('fa-moon');
        icon.classList.add('fa-sun');
        localStorage.setItem('theme', 'dark');
    } else {
        root.setAttribute('data-theme', 'light');
        icon.classList.remove('fa-sun');
        icon.classList.add('fa-moon');
        localStorage.setItem('theme', 'light');
    }
}

function showNotifications() {
    alert('Notifications:\n\n1. New user registered (2 min ago)\n2. License generated (15 min ago)\n3. System updated (3 hours ago)');
}

(function() {
    var saved = localStorage.getItem('theme');
    if (saved === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
        setTimeout(function() {
            var icon = document.getElementById('theme-icon');
            if (icon) { icon.classList.remove('fa-sun'); icon.classList.add('fa-moon'); }
        }, 100);
    }
})();


async function loadTopUsers() {
    var list = document.getElementById('top-users');
    if (!list) return;
    try {
        var token = localStorage.getItem('token');
        var res = await fetch('/api/admin/users', { headers: { 'Authorization': 'Bearer ' + token } });
        var users = await res.json();
        if (!Array.isArray(users) || users.length === 0) {
            list.innerHTML = '<p style="color:var(--muted);text-align:center;padding:20px;">No users</p>';
            return;
        }
        list.innerHTML = users.slice(0, 4).map(function(u) {
            return '<div class="activity-item">' +
                '<div class="user-avatar" style="width:36px;height:36px;font-size:13px;">' + u.username.charAt(0).toUpperCase() + '</div>' +
                '<div style="flex:1;"><div style="font-size:14px;font-weight:600;">' + u.username + '</div><div style="font-size:12px;color:var(--muted);">' + (u.role === 'admin' ? 'Administrator' : 'User') + '</div></div>' +
                '<span style="padding:4px 10px;border-radius:20px;background:' + (u.role === 'admin' ? 'rgba(139,92,246,.2);color:#8b5cf6' : 'rgba(16,185,129,.2);color:#10b981') + ';font-size:11px;font-weight:600;">' + u.role + '</span>' +
            '</div>';
        }).join('');
    } catch(e) { list.innerHTML = '<p style="color:var(--muted);text-align:center;padding:20px;">Error</p>'; }
}


async function loadSystemStatus() {
    try {
        // 1. Hubi Server-ka
        var serverStart = Date.now();
        var serverRes = await fetch('/api/health');
        var serverTime = Date.now() - serverStart;
        var serverData = await serverRes.json();
        
        document.getElementById('server-status').innerHTML = '<span style="color:var(--green);font-size:16px;">●</span> Online';
        document.getElementById('response-time').textContent = serverTime + 'ms';
        
        // 2. Server Details
        document.getElementById('server-details').innerHTML = 
            '<div style="font-size:13px;line-height:2;">' +
                '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Status:</span><strong style="color:var(--green);">' + (serverData.status || 'ok') + '</strong></div>' +
                '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Version:</span><strong>' + (serverData.version || 'N/A') + '</strong></div>' +
                '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Node:</span><strong>' + (serverData.node_version || 'N/A') + '</strong></div>' +
                '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Environment:</span><strong>' + (serverData.environment || 'N/A') + '</strong></div>' +
                '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Users:</span><strong>' + (serverData.database?.users || 0) + '</strong></div>' +
                '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Licenses:</span><strong>' + (serverData.database?.licenses || 0) + '</strong></div>' +
                '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Uptime:</span><strong>' + Math.floor(serverData.uptime || 0) + 's</strong></div>' +
            '</div>';
        
        // 3. Hubi Worker-ka
        var workerUrl = 'https://a.dirxx.workers.dev';
        try {
            var workerRes = await fetch('/api/worker-check?worker_url=' + encodeURIComponent(workerUrl));
            var workerData = await workerRes.json();
            
            if (workerData.reachable) {
                document.getElementById('worker-status').innerHTML = '<span style="color:var(--green);font-size:16px;">●</span> Online';
                document.getElementById('connection-status').innerHTML = '<span style="color:var(--green);font-size:16px;">●</span> Connected';
                document.getElementById('worker-details').innerHTML = 
                    '<div style="font-size:13px;line-height:2;">' +
                        '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Status:</span><strong style="color:var(--green);">Online</strong></div>' +
                        '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">URL:</span><strong style="font-size:11px;">' + workerUrl + '</strong></div>' +
                        '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">HTTP:</span><strong>' + (workerData.http_status || 'N/A') + '</strong></div>' +
                        '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Type:</span><strong>' + (workerData.content_type || 'N/A') + '</strong></div>' +
                        '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Proxied:</span><strong style="color:var(--green);">' + (workerData.is_proxied ? 'Yes' : 'No') + '</strong></div>' +
                        '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Response:</span><strong>' + (workerData.response_time || 'N/A') + '</strong></div>' +
                        '<div style="margin-top:10px;padding:10px;background:rgba(16,185,129,.1);border-radius:8px;font-size:12px;color:var(--green);">' + (workerData.message || '') + '</div>' +
                    '</div>';
            } else {
                document.getElementById('worker-status').innerHTML = '<span style="color:var(--yellow);font-size:16px;">●</span> Warning';
                document.getElementById('connection-status').innerHTML = '<span style="color:var(--yellow);font-size:16px;">●</span> Partial';
                document.getElementById('worker-details').innerHTML = 
                    '<div style="font-size:13px;line-height:2;">' +
                        '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Status:</span><strong style="color:var(--yellow);">Warning</strong></div>' +
                        '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">URL:</span><strong style="font-size:11px;">' + workerUrl + '</strong></div>' +
                        '<div style="display:flex;justify-content:space-between;"><span style="color:var(--muted);">Error:</span><strong style="color:var(--red);font-size:11px;">' + (workerData.error || 'Unknown') + '</strong></div>' +
                    '</div>';
            }
        } catch (workerError) {
            document.getElementById('worker-status').textContent = 'Error';
            document.getElementById('connection-status').textContent = 'Error';
        }
    } catch (error) {
        console.error('Status error:', error);
        document.getElementById('server-status').textContent = 'Error';
    }
}

async function testWorkerConnection() {
    var url = document.getElementById('worker-url-input').value.trim();
    var result = document.getElementById('test-result');
    if (!url) { showToast('Warning', 'Fadlan geli Worker URL', 'info'); return; }
    
    result.innerHTML = '<p style="color:var(--muted);">Testing connection...</p>';
    
    try {
        var start = Date.now();
        var res = await fetch('/api/worker-check?worker_url=' + encodeURIComponent(url));
        var data = await res.json();
        var time = Date.now() - start;
        
        if (data.reachable) {
            result.innerHTML = 
                '<div style="padding:15px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:10px;">' +
                    '<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">' +
                        '<i class="fa-solid fa-check-circle" style="color:var(--green);font-size:20px;"></i>' +
                        '<strong style="color:var(--green);">Connection Successful!</strong>' +
                    '</div>' +
                    '<div style="font-size:13px;color:var(--muted);">' +
                        '<div>Worker: <strong style="color:var(--text);">' + url + '</strong></div>' +
                        '<div>Response Time: <strong style="color:var(--text);">' + (data.response_time || time + 'ms') + '</strong></div>' +
                        '<div>HTTP Status: <strong style="color:var(--text);">' + (data.http_status || 'N/A') + '</strong></div>' +
                    '</div>' +
                '</div>';
        } else {
            result.innerHTML = 
                '<div style="padding:15px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);border-radius:10px;">' +
                    '<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">' +
                        '<i class="fa-solid fa-times-circle" style="color:var(--red);font-size:20px;"></i>' +
                        '<strong style="color:var(--red);">Connection Failed!</strong>' +
                    '</div>' +
                    '<div style="font-size:13px;color:var(--muted);">' +
                        '<div>Worker: <strong style="color:var(--text);">' + url + '</strong></div>' +
                        '<div>Error: <strong style="color:var(--red);">' + (data.error || 'Unknown') + '</strong></div>' +
                        '<div style="margin-top:10px;">Hubi in Worker-kaagu uu jiro oo uu si fiican u shaqeynayo.</div>' +
                    '</div>' +
                '</div>';
        }
    } catch (error) {
        result.innerHTML = 
            '<div style="padding:15px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);border-radius:10px;">' +
                '<strong style="color:var(--red);">Error: ' + error.message + '</strong>' +
            '</div>';
    }
}


    // ===== EDIT USER ROLE =====
    async function editUserRole(id, currentRole) {
        var newRole = prompt('Geli role-ka cusub (user ama admin):', currentRole);
        if (!newRole) return;
        if (newRole !== 'user' && newRole !== 'admin') {
            showToast('Warning', 'Role-ku waa inuu noqdaa user ama admin', 'info');
            return;
        }
        try {
            var token = localStorage.getItem('token');
            var res = await fetch('/api/admin/users/' + id, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify({ role: newRole })
            });
            if (res.ok) {
                showToast('Success!', 'Role-ka waa la beddelay!', 'success');
                loadUsers();
            } else {
                showToast('Error', 'Role-ka lama beddeli karin', 'error');
            }
        } catch (e) {
            showToast('Error', e.message, 'error');
        }
    }

    
    // ===== GOD MODE FEATURES =====
    function startLiveClock() {
        function update() {
            var el = document.getElementById('live-clock-text');
            if (el) {
                var now = new Date();
                var h = String(now.getHours()).padStart(2,'0');
                var m = String(now.getMinutes()).padStart(2,'0');
                var s = String(now.getSeconds()).padStart(2,'0');
                el.textContent = h + ':' + m + ':' + s;
            }
        }
        update();
        setInterval(update, 1000);
    }
    
    async function updateOnlineCount() {
        try {
            var token = localStorage.getItem('token');
            var r = await fetch('/api/stats', { headers: { 'Authorization': 'Bearer ' + token } });
            var d = await r.json();
            var el = document.getElementById('online-count');
            if (el) el.textContent = (d.totalUsers || 0) + ' Online';
        } catch(e) {}
    }
    
    function animateNumber(el, target) {
        var current = 0;
        var step = Math.max(1, Math.ceil(target / 30));
        var timer = setInterval(function() {
            current += step;
            if (current >= target) { current = target; clearInterval(timer); }
            el.textContent = current;
        }, 30);
    }
    
    startLiveClock();
    setInterval(updateOnlineCount, 30000);
    updateOnlineCount();

    
    // ===== GOD MODE JAVASCRIPT =====
    function startLiveClock() {
        function tick() {
            var el = document.getElementById('live-clock');
            if (el) {
                var d = new Date();
                el.textContent = String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0') + ':' + String(d.getSeconds()).padStart(2,'0');
            }
        }
        tick();
        setInterval(tick, 1000);
    }
    
    async function updateOnline() {
        try {
            var t = localStorage.getItem('token');
            var r = await fetch('/api/stats', { headers: { 'Authorization': 'Bearer ' + t } });
            var d = await r.json();
            var el = document.getElementById('online-count');
            if (el) el.textContent = (d.totalUsers || 0) + ' Online';
        } catch(e) {}
    }
    
    function animateValue(el, target, duration) {
        if (!el) return;
        var start = 0, startTime = null;
        function step(ts) {
            if (!startTime) startTime = ts;
            var progress = Math.min((ts - startTime) / duration, 1);
            el.textContent = Math.floor(progress * (target - start) + start);
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = target;
        }
        requestAnimationFrame(step);
    }
    
    startLiveClock();
    setInterval(updateOnline, 20000);
    updateOnline();

    
    // ===== GOD MODE 2.0 FUNCTIONS =====
    function startLiveClock() {
        function tick() {
            var el = document.getElementById('live-clock');
            if (el) {
                var d = new Date();
                el.textContent = String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0') + ':' + String(d.getSeconds()).padStart(2,'0');
            }
        }
        tick();
        setInterval(tick, 1000);
    }
    
    async function updateOnline() {
        try {
            var t = localStorage.getItem('token');
            var r = await fetch('/api/stats', { headers: { 'Authorization': 'Bearer ' + t } });
            var d = await r.json();
            var el = document.getElementById('online-count');
            if (el) el.textContent = (d.totalUsers || 0) + ' Online';
        } catch(e) {}
    }
    
    async function exportData() {
        try {
            var t = localStorage.getItem('token');
            var r = await fetch('/api/admin/users', { headers: { 'Authorization': 'Bearer ' + t } });
            var users = await r.json();
            var csv = 'ID,Username,Full Name,Role,License,Referral,Status\n';
            users.forEach(function(u) {
                csv += u.id + ',' + u.username + ',' + (u.fullname || '') + ',' + u.role + ',' + (u.license_key || '') + ',' + (u.referral_code || '') + ',' + (u.status || 'active') + '\n';
            });
            var blob = new Blob([csv], { type: 'text/csv' });
            var url = window.URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = 'abdi-vip-users-' + Date.now() + '.csv';
            a.click();
            window.URL.revokeObjectURL(url);
        } catch(e) { showToast('Error', 'Export failed: ' + e.message, 'error'); }
    }
    
    function showNotifications() {
        alert('Notifications:\n\n1. New user registered (2 min ago)\n2. License generated (15 min ago)\n3. System updated (3 hours ago)');
    }
    
    startLiveClock();
    setInterval(updateOnline, 20000);
    updateOnline();

    
    // ===== MODERN MODAL FUNCTIONS =====
    var modernSelectedDays = 1;
    
    function showModernLicenseModal() {
        document.getElementById('modern-license-modal').classList.add('active');
        document.getElementById('modern-quantity').value = 1;
        document.getElementById('modern-custom-days').style.display = 'none';
        modernSelectedDays = 1;
        document.querySelectorAll('.modern-duration-btn').forEach(function(b) {
            b.classList.remove('active');
            if (b.getAttribute('data-days') === '1') b.classList.add('active');
        });
    }
    
    function closeModernModal() {
        document.getElementById('modern-license-modal').classList.remove('active');
    }
    
    function selectModernDuration(btn, days) {
        document.querySelectorAll('.modern-duration-btn').forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        modernSelectedDays = days;
        var customInput = document.getElementById('modern-custom-days');
        if (days === 'custom') {
            customInput.style.display = 'block';
            customInput.focus();
        } else {
            customInput.style.display = 'none';
        }
    }
    
    async function generateModernLicenses() {
        var days = modernSelectedDays;
        if (days === 'custom') {
            days = parseInt(document.getElementById('modern-custom-days').value);
            if (!days || days < 1) { showToast('Warning', 'Fadlan geli tirada maalmood ee saxda ah', 'info'); return; }
        }
        var qty = parseInt(document.getElementById('modern-quantity').value) || 1;
        try {
            var token = localStorage.getItem('token');
            var res = await fetch('/api/admin/licenses/bulk', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify({ days: days, quantity: qty })
            });
            var data = await res.json();
            if (data.ok || data.success) {
                closeModernModal();
                showToast('Success!', qty + ' license(s) waa la abuuray!', 'success');
                loadLicenses();
                if (typeof fetchStats === 'function') fetchStats();
            } else {
                showToast('Error', data.error || 'Unknown error', 'error');
            }
        } catch(e) { showToast('Error', e.message, 'error'); }
    }

    
    // ===== MODERN TOAST =====
    function showToast(title, message, type) {
        type = type || 'success';
        var container = document.getElementById('toast-container');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'toast-container';
            document.body.appendChild(container);
        }
        var icons = { success: 'fa-check-circle', error: 'fa-times-circle', info: 'fa-info-circle' };
        var toast = document.createElement('div');
        toast.className = 'toast';
        toast.innerHTML = '<div class="toast-icon ' + type + '"><i class="fa-solid ' + (icons[type] || icons.success) + '"></i></div>' +
            '<div class="toast-content"><div class="toast-title">' + title + '</div><div class="toast-message">' + message + '</div></div>' +
            '<button class="toast-close" onclick="this.parentElement.remove()"><i class="fa-solid fa-xmark"></i></button>' +
            '<div class="toast-progress"></div>';
        container.appendChild(toast);
        setTimeout(function() {
            toast.classList.add('removing');
            setTimeout(function() { toast.remove(); }, 300);
        }, 3000);
    }

    
    // ===== THEME SWITCHER =====
    function setTheme(theme) {
        var root = document.documentElement;
        var buttons = document.querySelectorAll('.theme-btn');
        buttons.forEach(function(btn) { btn.classList.remove('active'); });
        if (theme === 'light') {
            root.setAttribute('data-theme', 'light');
            if (buttons[1]) buttons[1].classList.add('active');
            localStorage.setItem('abdi_theme', 'light');
            if (typeof showToast === 'function') showToast('Theme', 'Light Mode (Cream/Soft) waa la shidey!', 'info');
        } else if (theme === 'dark') {
            root.removeAttribute('data-theme');
            if (buttons[0]) buttons[0].classList.add('active');
            localStorage.setItem('abdi_theme', 'dark');
            if (typeof showToast === 'function') showToast('Theme', 'Dark Mode waa la shidey!', 'info');
        } else {
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
                root.setAttribute('data-theme', 'light');
            } else {
                root.removeAttribute('data-theme');
            }
            if (buttons[2]) buttons[2].classList.add('active');
            localStorage.setItem('abdi_theme', 'auto');
            if (typeof showToast === 'function') showToast('Theme', 'Auto Mode waa la shidey!', 'info');
        }
    }
    
    // Soo celi theme-ka la keydiyay marka boggu furmo
    (function() {
        var saved = localStorage.getItem('abdi_theme');
        if (saved === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
        }
    })();

    function handleLogout(){localStorage.removeItem('token');localStorage.removeItem('user');location.reload();}
if(localStorage.getItem('token')){showDashboard();}
</script>

<!-- MODERN GENERATE LICENSE MODAL -->
<div id="modern-license-modal" class="modern-modal-overlay">
    <div class="modern-modal">
        <div class="modern-modal-header">
            <h2 class="modern-modal-title"><i class="fa-solid fa-key"></i> Generate License</h2>
            <button class="modern-modal-close" onclick="closeModernModal()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        
        <label class="modern-label">Duration</label>
        <div class="modern-duration-grid">
            <button type="button" class="modern-duration-btn active" data-days="1" onclick="selectModernDuration(this, 1)">
                <i class="fa-solid fa-calendar-day"></i>1 Day
            </button>
            <button type="button" class="modern-duration-btn" data-days="7" onclick="selectModernDuration(this, 7)">
                <i class="fa-solid fa-calendar-week"></i>7 Days
            </button>
            <button type="button" class="modern-duration-btn" data-days="30" onclick="selectModernDuration(this, 30)">
                <i class="fa-solid fa-calendar"></i>30 Days
            </button>
            <button type="button" class="modern-duration-btn" data-days="90" onclick="selectModernDuration(this, 90)">
                <i class="fa-solid fa-calendar-plus"></i>90 Days
            </button>
            <button type="button" class="modern-duration-btn" data-days="365" onclick="selectModernDuration(this, 365)">
                <i class="fa-solid fa-calendar-check"></i>1 Year
            </button>
            <button type="button" class="modern-duration-btn" data-days="custom" onclick="selectModernDuration(this, 'custom')">
                <i class="fa-solid fa-sliders"></i>Custom
            </button>
        </div>
        
        <input type="number" id="modern-custom-days" class="modern-quantity-input" placeholder="Enter custom days" style="display:none;">
        
        <label class="modern-label">Quantity</label>
        <input type="number" id="modern-quantity" class="modern-quantity-input" value="1" min="1" max="100">
        
        <button class="modern-generate-btn" onclick="generateModernLicenses()">
            <i class="fa-solid fa-bolt"></i> Generate Now
        </button>
    </div>
</div>

<div id="toast-container" class="toast-container"></div>
</body>
</html>